*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#eef3f8;color:#1f2937}
.container{max-width:1100px;width:94%;margin:30px auto}
header{background:#145da0;color:#fff;padding:30px;border-radius:16px}
.tag{font-size:13px;font-weight:bold}
h1{margin:8px 0;font-size:34px}
header p{margin:0}
.intro,.card,.result,.flow,.error{background:#fff;padding:24px;margin-top:18px;border-radius:14px;box-shadow:0 4px 15px #0001}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.card h3{margin-top:0}
label{display:block;font-weight:bold;margin-bottom:10px}
input[type=file]{width:100%;padding:14px;border:1px dashed #94a3b8;border-radius:10px;background:#f8fafc}
small{display:block;margin-top:10px;color:#64748b}
button{display:block;margin:20px auto;padding:14px 28px;border:0;border-radius:10px;background:#145da0;color:white;font-size:16px;font-weight:bold;cursor:pointer}
.error{border-left:7px solid #c62828;color:#8b1e1e}
.result{text-align:center}
.accepted{border-left:7px solid #16803c}
.rejected{border-left:7px solid #c62828}
.accepted h2{color:#16803c}
.rejected h2{color:#c62828}
.file-names{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left;margin:18px 0}
.file-names div{background:#f1f5f9;padding:12px;border-radius:8px;overflow-wrap:anywhere}
.crc-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.crc-grid div{background:#f1f5f9;padding:18px;border-radius:10px}
.crc-grid span{display:block;font-size:13px}
.crc-grid strong{display:block;font:24px Consolas;margin-top:7px}
.diff{text-align:left;margin-top:20px}
.diff pre{background:#111827;color:#e5e7eb;padding:18px;border-radius:10px;overflow:auto;white-space:pre-wrap}
.flow{text-align:center}
.flow-row{display:flex;justify-content:center;align-items:center;gap:8px;flex-wrap:wrap}
.flow-row span{background:#e8f1fa;padding:12px;border-radius:8px;font-weight:bold}
footer{text-align:center;color:#64748b;padding:22px}
@media(max-width:700px){.grid,.crc-grid,.file-names{grid-template-columns:1fr}h1{font-size:27px}}
